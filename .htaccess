<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Strictly block direct access to sensitive files and directories
    RewriteRule ^(dev-tools/|\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|.*\.sql|.*\.sqlite|.*\.log|phpunit\.xml) - [F,L,NC]

    # 2. Prevent access to storage app private files directly
    RewriteRule ^storage/app/.* - [F,L,NC]

    # 3. Automatically route all requests to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden files (.env, .git, etc.) and database backups
<FilesMatch "^\.|\.(sql|env|log|md|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

